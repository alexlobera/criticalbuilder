{
  "name": "criticalbuilder",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "check": "astro check && npm run cf-typegen --silent && tsc -p worker",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "newsletter": "node --env-file-if-exists=.env scripts/newsletter.ts",
    "deploy": "astro build && wrangler deploy",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.11",
    "satori": "^0.63.2",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "resend": "^6.38.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.160.1"
  }
}
