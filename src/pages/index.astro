---
import NewsletterSection from '../components/NewsletterSection.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import PostList from '../components/PostList.astro';
import { AUTHOR, HOME_HEADING, SITE_DESCRIPTION } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../lib/posts';

const [latest, ...older] = await getPosts();
---

<BaseLayout>
  <section class="mb-12">
    <h1 class="mb-4 text-2xl font-bold text-strong">{HOME_HEADING}</h1>
    <p class="max-w-[62ch] leading-7">
      {SITE_DESCRIPTION} Written by {AUTHOR}. New posts by <a href="/rss.xml" class="link text-link"
        >RSS</a
      > or <a href="/newsletter" class="link text-link">email</a>.
    </p>
  </section>

  {
    latest ? (
      <>
        <section class="mb-14" aria-labelledby="latest">
          <h2 id="latest" class="section-title mb-4">
            Latest
          </h2>
          <FeaturedPost post={latest} />
        </section>
        {older.length > 0 && (
          <section aria-labelledby="posts">
            <h2 id="posts" class="section-title mb-4">
              Posts
            </h2>
            <PostList posts={older} />
          </section>
        )}
      </>
    ) : (
      <p class="text-muted">The first post is on its way.</p>
    )
  }

  <NewsletterSection id="home-newsletter" />
</BaseLayout>
