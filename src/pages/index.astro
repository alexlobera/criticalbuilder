---
import PostList from '../components/PostList.astro';
import { AUTHOR, ESTABLISHED, HOME_POST_COUNT, SITE_DESCRIPTION } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
const latest = posts.slice(0, HOME_POST_COUNT);
---

<BaseLayout>
  <section class="hero wrap row">
    <p class="margin label reveal">Est. {ESTABLISHED}</p>
    <div class="main">
      <h1 class="display reveal" style="--i: 1">
        Critical <em>Builder</em><span class="dot">.</span>
      </h1>
      <p class="intro reveal" style="--i: 2">{SITE_DESCRIPTION}</p>
      <p class="label byline reveal" style="--i: 3">Written by {AUTHOR}</p>
    </div>
  </section>

  <section class="section wrap row" aria-labelledby="latest">
    <h2 id="latest" class="margin label">Latest</h2>
    <div class="main">
      {
        latest.length > 0 ? (
          <>
            <PostList posts={latest} delay={4} />
            {posts.length > latest.length && (
              <p class="more">
                <a class="arrow-link" href="/blog">
                  All {posts.length} posts <span aria-hidden="true">→</span>
                </a>
              </p>
            )}
          </>
        ) : (
          <p class="empty">The first post is on its way.</p>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(3.5rem, 10vw, 7.5rem) clamp(3rem, 7vw, 5rem);
  }
  .hero .margin {
    padding-top: 1.1rem;
  }
  .display {
    margin: 0 0 1.75rem;
    font-size: clamp(3.4rem, 10.5vw, 6.75rem);
    font-weight: 380;
    line-height: 0.92;
    letter-spacing: -0.035em;
    margin-left: -0.05em;
  }
  .display em {
    font-weight: 330;
  }
  .dot {
    color: var(--accent);
  }
  .intro {
    margin: 0 0 1.75rem;
    max-width: 30rem;
    font-size: clamp(1.25rem, 2.4vw, 1.5rem);
    line-height: 1.4;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .more {
    margin: 2.25rem 0 0;
  }
  .empty {
    margin: 0;
    font-style: italic;
    color: var(--muted);
  }
  @media (max-width: 56rem) {
    .hero .margin {
      padding-top: 0;
      margin-bottom: 1.25rem;
    }
  }
</style>
