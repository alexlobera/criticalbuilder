---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="This page doesn't exist." noindex>
  <p class="mb-3 text-xs text-muted">
    <span class="text-accent">$</span> cd <span data-missing-path>that-page</span>
  </p>
  <h1 class="mb-4 text-2xl font-bold text-strong">404: no such file or directory</h1>
  <p class="mb-8 leading-relaxed">The page you're looking for doesn't exist, or it moved.</p>
  <p><a href="/" class="link text-link">cd ~</a> <span class="text-muted">(go home)</span></p>
</BaseLayout>

<script>
  // This page is served for every unknown URL, so show the one that was requested.
  const path = document.querySelector('[data-missing-path]');
  if (path) {
    try {
      path.textContent = decodeURI(location.pathname);
    } catch {
      path.textContent = location.pathname;
    }
  }
</script>
