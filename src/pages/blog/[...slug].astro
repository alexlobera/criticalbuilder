---
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import NewsletterSection from '../../components/NewsletterSection.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getPosts,
  longDate,
  ogImageUrl,
  postNumber,
  postUrl,
  tagUrl,
  type BlogPost,
} from '../../lib/posts';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: BlogPost;
  newer?: BlogPost;
  older?: BlogPost;
}

const { post, newer, older } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover, coverAlt } = post.data;
const { Content } = await render(post);
---

<BaseLayout
  title={title}
  description={description}
  image={ogImageUrl(post)}
  article={{ publishedTime: pubDate, modifiedTime: updatedDate, tags }}
>
  <article>
    <header class="mb-8">
      <p class="mb-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted">
        {/* `npm run newsletter` reads the number from data-post-number. */}
        <span class="font-bold text-accent" data-post-number>{postNumber(post)}</span>
        <span aria-hidden="true">/</span>
        <time datetime={pubDate.toISOString()}>{longDate(pubDate)}</time>
        <span aria-hidden="true">/</span>
        <span>{post.minutes} min read</span>
        {
          updatedDate && (
            <span class="bg-accent/10 px-1.5 py-0.5 text-accent">
              Updated: <time datetime={updatedDate.toISOString()}>{longDate(updatedDate)}</time>
            </span>
          )
        }
      </p>
      <h1 class="mb-3 text-2xl leading-snug font-bold text-balance text-strong sm:text-[1.75rem]">
        {title}
      </h1>
      <p class="leading-relaxed text-pretty text-muted">{description}</p>
      {
        tags.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-xs" aria-label="Tags">
            {tags.map((tag) => (
              <li>
                <a href={tagUrl(tag)} class="text-link underline-offset-[3px] hover:underline">
                  #{tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {/* Markers let `npm run newsletter` lift the cover and rendered post into an email. */}
    <Fragment set:html="<!-- email-content:start -->" />
    {
      cover && (
        <figure class="mb-8">
          {/* AVIF/WebP for browsers, with a JPEG <img> that email clients fall back to. */}
          <Picture
            src={cover}
            alt={coverAlt ?? ''}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[720, 1080, 1440]}
            sizes="(min-width: 48rem) 44rem, 100vw"
            loading="eager"
            fetchpriority="high"
            class="cover-img w-full border border-rule"
          />
        </figure>
      )
    }
    <div class="prose">
      <Content />
    </div>
    <Fragment set:html="<!-- email-content:end -->" />
  </article>

  <NewsletterSection id="post-newsletter" />

  <nav class="mt-12 border-t border-dashed border-rule pt-6" aria-label="More posts">
    <div class="grid gap-6 sm:grid-cols-2">
      {
        older && (
          <a href={postUrl(older)} rel="prev" class="group block">
            <span class="text-xs text-muted">← Older</span>
            <span class="mt-1 block font-bold text-balance text-strong group-hover:underline group-hover:decoration-accent underline-offset-4">
              {older.data.title}
            </span>
          </a>
        )
      }
      {
        newer && (
          <a href={postUrl(newer)} rel="next" class="group block sm:col-start-2 sm:text-right">
            <span class="text-xs text-muted">Newer →</span>
            <span class="mt-1 block font-bold text-balance text-strong group-hover:underline group-hover:decoration-accent underline-offset-4">
              {newer.data.title}
            </span>
          </a>
        )
      }
    </div>
    <p class="mt-8 text-xs">
      <a href="/" class="text-accent underline-offset-[3px] hover:underline">← All posts</a>
    </p>
  </nav>
</BaseLayout>
