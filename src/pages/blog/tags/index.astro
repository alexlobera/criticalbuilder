---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPosts, getTags, tagUrl } from '../../../lib/posts';

const tags = getTags(await getPosts());
---

<BaseLayout title="Tags" description="Posts on Critical Builder, by topic.">
  <header class="page-head wrap row">
    <p class="margin label reveal">Index</p>
    <div class="main">
      <h1 class="reveal" style="--i: 1">Tags</h1>
      {
        tags.length > 0 ? (
          <ul class="tag-list reveal" style="--i: 2">
            {tags.map((tag) => (
              <li>
                <a class="tag" href={tagUrl(tag.name)}>
                  {tag.name}
                  <span class="count">{tag.posts.length}</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">No tags yet.</p>
        )
      }
      <p class="back">
        <a class="arrow-link back" href="/blog"><span aria-hidden="true">←</span> All posts</a>
      </p>
    </div>
  </header>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(3rem, 8vw, 5.5rem) 2rem;
  }
  .page-head .margin {
    padding-top: 0.9rem;
  }
  h1 {
    margin: 0 0 2rem;
    font-size: clamp(2.75rem, 7vw, 4.25rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .empty {
    font-style: italic;
    color: var(--muted);
  }
  .back {
    margin-top: 3rem;
  }
  @media (max-width: 56rem) {
    .page-head .margin {
      padding-top: 0;
      margin-bottom: 1rem;
    }
  }
</style>
