---
import PostList from '../../../components/PostList.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPosts, getTags, type Tag } from '../../../lib/posts';

export async function getStaticPaths() {
  const tags = getTags(await getPosts());
  return tags.map((tag) => ({ params: { tag: tag.slug }, props: { tag } }));
}

interface Props {
  tag: Tag;
}

const { tag } = Astro.props;
const count = `${tag.posts.length} ${tag.posts.length === 1 ? 'post' : 'posts'}`;
---

<BaseLayout title={`Posts tagged “${tag.name}”`} description={`Posts about ${tag.name} on Critical Builder.`}>
  <p class="mb-2 text-xs">
    <a href="/" class="text-accent underline-offset-[3px] hover:underline">← All posts</a>
  </p>
  <h1 class="mb-1 text-2xl font-bold text-strong"><span class="text-accent">#</span>{tag.name}</h1>
  <p class="mb-10 text-xs text-muted">{count}</p>
  <h2 class="sr-only">Posts</h2>
  <PostList posts={tag.posts} eager />
</BaseLayout>
