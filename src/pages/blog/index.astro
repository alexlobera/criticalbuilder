---
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getTags, tagUrl } from '../../lib/posts';

const posts = await getPosts();
const tags = getTags(posts);
---

<BaseLayout title="Blog" description="Everything published on Critical Builder.">
  <header class="page-head wrap row">
    <p class="margin label reveal">Archive</p>
    <div class="main">
      <h1 class="reveal" style="--i: 1">All writing</h1>
      <p class="label reveal" style="--i: 2">
        {posts.length} {posts.length === 1 ? 'post' : 'posts'}
      </p>
      {
        tags.length > 0 && (
          <nav class="reveal" style="--i: 3" aria-label="Tags">
            <ul class="tag-list">
              {tags.map((tag) => (
                <li>
                  <a class="tag" href={tagUrl(tag.name)}>
                    {tag.name}
                    <span class="count">{tag.posts.length}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>
  </header>

  <section class="section wrap row" aria-label="Posts">
    <div class="main">
      {
        posts.length > 0 ? (
          <PostList posts={posts} delay={4} />
        ) : (
          <p class="empty">Nothing published yet.</p>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(3rem, 8vw, 5.5rem) 2.75rem;
  }
  .page-head .margin {
    padding-top: 0.9rem;
  }
  h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2.75rem, 7vw, 4.25rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  nav {
    margin-top: 1.75rem;
  }
  .empty {
    margin: 0;
    font-style: italic;
    color: var(--muted);
  }
  @media (max-width: 56rem) {
    .page-head .margin {
      padding-top: 0;
      margin-bottom: 1rem;
    }
  }
</style>
