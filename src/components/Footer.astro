---
import { AUTHOR, NAV_LINKS } from '../consts';

const year = new Date().getFullYear();
const links = [...NAV_LINKS, { href: '/rss.xml', label: 'RSS' }];
---

<footer
  class="mt-20 flex flex-col items-center justify-between gap-3 border-t border-dashed border-rule pt-6 pb-10 text-xs text-muted sm:flex-row"
>
  <p>Copyright © {year} {AUTHOR}</p>
  <nav aria-label="More on this site">
    <ul class="flex flex-wrap justify-center gap-x-4 gap-y-1">
      {
        links.map(({ href, label }) => (
          <li>
            <a href={href} class="underline-offset-[3px] hover:text-text hover:underline">
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</footer>
