---
import NewsletterForm from './NewsletterForm.astro';

interface Props {
  id?: string;
}

const { id = 'newsletter' } = Astro.props;
---

<section
  class="mt-16 border border-dashed border-rule bg-surface px-4 py-5 sm:px-5"
  aria-labelledby={`${id}-title`}
>
  <h2 id={`${id}-title`} class="mb-2 font-normal text-strong">
    <span class="text-accent" aria-hidden="true">$</span> subscribe --to critical-builder
  </h2>
  <p class="mb-4 leading-relaxed">
    Get new posts by email. One email when something new is published. Unsubscribe anytime.
  </p>
  <NewsletterForm id={`${id}-email`} />
</section>
