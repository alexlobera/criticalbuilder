---
import { postUrl, type BlogPost } from '../lib/posts';
import Cover from './Cover.astro';
import PostMeta from './PostMeta.astro';

interface Props {
  posts: BlogPost[];
  /** Load the first thumbnails eagerly when the list is the first thing on the page. */
  eager?: boolean;
}

const { posts, eager = false } = Astro.props;
---

{/* One post per row: thumbnail on the left, details on the right. */}
<ul class="space-y-8" role="list">
  {
    posts.map((post, i) => (
      <li>
        <article class="post-item group grid grid-cols-[7rem_minmax(0,1fr)] items-start gap-x-4 sm:grid-cols-[12rem_minmax(0,1fr)] sm:gap-x-5">
          <a href={postUrl(post)} tabindex="-1" aria-hidden="true" class="block">
            <Cover post={post} size="thumb" eager={eager && i < 3} />
          </a>
          <div>
            <PostMeta post={post} class="mb-1.5" />
            <h3 class="mb-1 leading-snug font-bold text-balance text-strong sm:text-[0.9375rem]">
              <a
                href={postUrl(post)}
                class="decoration-accent underline-offset-4 group-hover:underline"
              >
                {post.data.title}
              </a>
            </h3>
            <p class="line-clamp-3 leading-relaxed text-pretty sm:line-clamp-none">
              {post.data.description}
            </p>
          </div>
        </article>
      </li>
    ))
  }
</ul>
