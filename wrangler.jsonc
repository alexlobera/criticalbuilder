// Cloudflare Workers deployment.
// Pages are static files from ./dist. A small Worker (worker/index.ts) handles the
// newsletter endpoints; every other request is served straight from the static assets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "criticalbuilder",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serves blog/my-post.html at /blog/my-post.
    "html_handling": "auto-trailing-slash",
    // Unknown paths get dist/404.html with a 404 status.
    "not_found_handling": "404-page",
    // Only these paths reach the Worker. Everything else is served as static files.
    "run_worker_first": ["/api/*", "/newsletter/confirm"]
  },
  "vars": {
    "SITE_URL": "https://criticalbuilder.com",
    // Must use a domain verified in Resend.
    "NEWSLETTER_FROM": "Critical Builder <newsletter@news.criticalbuilder.com>",
    // Resend → Audience → Segments. Subscribers are added to this segment and
    // newsletters are sent to it.
    "RESEND_SEGMENT_ID": ""
  },
  // Secrets (set with `npx wrangler secret put <NAME>`, or in .dev.vars locally):
  //   RESEND_API_KEY        Resend API key with full access
  //   NEWSLETTER_SECRET     Random string used to sign confirmation links
  //   TURNSTILE_SECRET_KEY  Optional. Enables Cloudflare Turnstile bot checks
  "ratelimits": [
    {
      "name": "SUBSCRIBE_LIMITER",
      "namespace_id": "1001",
      // At most 5 signup attempts per IP address per minute.
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
